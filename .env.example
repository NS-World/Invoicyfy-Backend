# Copy this file to .env and fill in real values. Never commit .env.
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata

DB_HOST=localhost
DB_PORT=3306
DB_NAME=invoice_system
DB_USER=root
DB_PASS=

# Comma separated list of front-end origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Generate with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Encrypts saved secrets such as the WhatsApp access token (falls back to JWT_ACCESS_SECRET).
# Keep it the same after a restore, otherwise re-enter the WhatsApp token.
APP_KEY=change-me-app-key
# WhatsApp Business Cloud API base URL (change only for testing)
WHATSAPP_API_BASE=https://graph.facebook.com/v21.0

# Public address of this API, used for offer picture links (optional — worked out automatically).
# APP_URL=https://billing.scoopiez.in/api

# ---- Khanak SaaS (sell plans, one database per shop). Off unless SAAS_MODE=true. See DEPLOY-HOSTINGER.md ----
# SAAS_MODE=true
# SAAS_DB_NAME=khanak_control
# SAAS_DB_PREFIX=khanak_t_
# SAAS_DB_POOL=                      # pre-made empty databases, comma separated (only when CREATE DATABASE is not allowed)
# SAAS_MASTER_KEY=change-me-64-hex   # never change after the first shop
# SAAS_PUBLIC_URL=https://app.khanak.in
# SAAS_APP_URL=                      # web app address for login links, if not the same as SAAS_PUBLIC_URL
# SAAS_PAYMENT_MODE=mock             # razorpay for real payments
# SAAS_RAZORPAY_KEY_ID=
# SAAS_RAZORPAY_KEY_SECRET=
# SAAS_RAZORPAY_WEBHOOK_SECRET=
